{
  "manifest_version": 3,
  "name": "MiniGo Wallet (testnet)",
  "version": "0.1.0",
  "description": "MiniGo's Stellar wallet for the browser. Testnet only.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["relay.js"], "run_at": "document_start" }
  ],
  "action": { "default_title": "MiniGo Wallet", "default_popup": "popup.html" }
}
